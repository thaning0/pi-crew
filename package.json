{
  "name": "pi-crew",
  "version": "2.1.0",
  "description": "Multi-agent crew orchestration extension for pi — spawn subagents, assign tasks, coordinate collaboration via a persistent room with git worktree isolation",
  "keywords": ["pi-package"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "pi": {
    "extensions": ["./extensions/crew", "./extensions/builtin-tools.ts", "./extensions/todo.ts", "./extensions/wait.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "dependencies": {
    "p-queue": "^9.2.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-agent-core": "*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "test": "cd extensions/crew && vitest run",
    "typecheck": "cd extensions/crew && tsc --noEmit"
  }
}
