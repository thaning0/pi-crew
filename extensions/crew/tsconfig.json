{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022"],
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["./*.ts"],
	"exclude": ["./*.test.ts", "./node_modules/**", "./docs/**"]
}